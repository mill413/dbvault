DBVAULT_ENV=dev
DBVAULT_DATABASE_URL=sqlite:///./dbvault.db
DBVAULT_REDIS_URL=redis://localhost:6379/0
DBVAULT_JWT_SECRET=change-me-in-production
DBVAULT_ENCRYPTION_KEY=
DBVAULT_POSTGRES_PASSWORD=change-me-in-production
DBVAULT_BACKUP_TMP_DIR=./dbvault_tmp
DBVAULT_LOCAL_STORAGE_ROOT=./dbvault_backups
DBVAULT_KUBECONFIG_DIR=./dbvault_kubeconfigs
DBVAULT_LOG_LEVEL=INFO
DBVAULT_OPENAPI_ENABLED=true
DBVAULT_SCHEDULER_ENABLED=true
DBVAULT_RUN_BACKGROUND_TASKS_INLINE=false
DBVAULT_ENABLE_REGISTRATION=false
DBVAULT_INITIAL_ADMIN_USERNAME=admin
DBVAULT_INITIAL_ADMIN_PASSWORD=admin123456789
