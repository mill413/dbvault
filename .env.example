# Runtime mode: use "dev" for local development and "prod" for deployed services.
DBVAULT_ENV=dev

# SQLAlchemy metadata database URL. SQLite is suitable for local development only;
# Docker Compose supplies its own PostgreSQL URL in production.
DBVAULT_DATABASE_URL=sqlite:///./dbvault.db

# Optional Redis connection used by the runtime stack.
DBVAULT_REDIS_URL=redis://localhost:6379/0

# Secret used to sign access and refresh tokens. Set a long, random, stable value
# in production; changing it immediately invalidates every existing login token.
DBVAULT_JWT_SECRET=change-me-in-production

# Fernet key used to encrypt database and storage credentials. It may be empty in
# development (derived from JWT secret), but production requires a 32-byte
# URL-safe base64 key. Generate one with:
# python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
DBVAULT_ENCRYPTION_KEY=

# Password for the PostgreSQL service created by Docker Compose.
DBVAULT_POSTGRES_PASSWORD=change-me-in-production

# Temporary work directory and default roots for local backups and kubeconfigs.
# Relative paths are resolved from the process working directory.
DBVAULT_BACKUP_TMP_DIR=./dbvault_tmp
DBVAULT_LOCAL_STORAGE_ROOT=./dbvault_backups
DBVAULT_KUBECONFIG_DIR=./dbvault_kubeconfigs

# Logging level accepted by Python logging, for example DEBUG, INFO, or WARNING.
DBVAULT_LOG_LEVEL=INFO

# Expose OpenAPI JSON and /docs. Consider disabling this on public deployments.
DBVAULT_OPENAPI_ENABLED=true

# Enable the in-process APScheduler service for scheduled backups.
DBVAULT_SCHEDULER_ENABLED=true

# Run background work inside the request process. Keep false in production;
# true is intended for deterministic development and automated tests.
DBVAULT_RUN_BACKGROUND_TASKS_INLINE=false

# Allow public account registration. Disabled by default.
DBVAULT_ENABLE_REGISTRATION=false

# Bootstrap administrator credentials, used only when no user exists yet.
# Always replace the default password before exposing a deployment.
DBVAULT_INITIAL_ADMIN_USERNAME=admin
DBVAULT_INITIAL_ADMIN_PASSWORD=admin123456789
